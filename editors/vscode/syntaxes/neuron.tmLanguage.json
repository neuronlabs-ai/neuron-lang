{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NEURON",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#effects" },
    { "include": "#functions" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.neuron",
          "match": "//.*$"
        },
        {
          "name": "comment.block.neuron",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.neuron",
          "match": "\\b(if|else|for|in|while|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.neuron",
          "match": "\\b(fn|let|model|agent|causal|temporal|effect|meta)\\b"
        },
        {
          "name": "keyword.other.neuron",
          "match": "\\b(update|by|grad|sgd|adam|adamw|sgd_momentum|observe|intervene|do|forget|search|remember|align|perceive|act)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.neuron",
          "match": "\\b(Tensor|Int|Float|Bool|String|Void|Dataset|Temporal|EpisodicMemory)\\b"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "entity.name.type.effect.neuron",
          "match": "\\[Effect\\[[^\\]]+\\]\\]"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.neuron",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.neuron",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.neuron",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.neuron",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.neuron",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.neuron",
          "match": "(@|\\+|\\-|\\*|/|%|=|==|!=|<|>|<=|>=|\\->|=>|\\|\\||&&)"
        }
      ]
    }
  },
  "scopeName": "source.neuron"
}
