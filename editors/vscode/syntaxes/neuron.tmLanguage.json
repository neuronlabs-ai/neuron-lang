{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NEURON",
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#cognitive" },
    { "include": "#types" },
    { "include": "#effects" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.neuron",
          "match": "//.*$"
        },
        {
          "name": "comment.block.neuron",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.tag.annotation.neuron",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.neuron",
          "match": "\\b(if|else|for|in|while|return|break|continue|match|yield|sync|async|await)\\b"
        },
        {
          "name": "keyword.declaration.neuron",
          "match": "\\b(fn|let|const|mut|pub|model|agent|causal|temporal|effect|meta|type|struct|enum|trait|impl|import|export|as)\\b"
        }
      ]
    },
    "cognitive": {
      "patterns": [
        {
          "name": "keyword.other.cognitive.neuron",
          "match": "\\b(update|by|grad|sgd|adam|adamw|sgd_momentum|observe|intervene|do|forget|search|remember|align|perceive|act|counterfactual|query|verify|prove|test|train|sample|checkpoint|restore)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.neuron",
          "match": "\\b(Tensor|Int|Float|Bool|String|Void|Dataset|Temporal|Stream|Offset|Uncertain|EpisodicMemory|Signal|Patch|ByteStream|State|Distribution|Graph|Any)\\b"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "entity.name.type.effect.neuron",
          "match": "\\[Effect\\[[^\\]]+\\]\\]"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.neuron",
          "match": "\\b(true|false|null|none|self)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.neuron",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.neuron",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.neuron",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.neuron",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.neuron",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.neuron",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.neuron",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.causal.neuron",
          "match": "(<-|~)"
        },
        {
          "name": "keyword.operator.temporal.neuron",
          "match": "(::)"
        },
        {
          "name": "keyword.operator.arrow.neuron",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.comparison.neuron",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.neuron",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.neuron",
          "match": "(@|\\+|\\-|\\*|/|%|\\^)"
        },
        {
          "name": "keyword.operator.bitwise.neuron",
          "match": "(&|\\||<<|>>)"
        },
        {
          "name": "keyword.operator.assignment.neuron",
          "match": "(=)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.neuron",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.bracket.neuron",
          "match": "[\\[\\]\\{\\}\\(\\)]"
        }
      ]
    }
  },
  "scopeName": "source.neuron"
}
