{
  "name": "neuron-lang-vscode",
  "displayName": "NEURON Programming Language",
  "description": "Official VS Code language support for NEURON — Differentiable & Causal AI Language",
  "version": "1.0.0",
  "publisher": "neuronlabs-ai",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:neuron"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "neuron",
        "aliases": [
          "NEURON",
          "neuron",
          "nr"
        ],
        "extensions": [
          ".nr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "neuron",
        "scopeName": "source.neuron",
        "path": "./syntaxes/neuron.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "NEURON",
      "properties": {
        "neuron.compilerPath": {
          "type": "string",
          "default": "neuronc",
          "description": "Path to the neuronc compiler binary"
        }
      }
    }
  }
}
